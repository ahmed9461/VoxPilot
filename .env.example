# =========================
# VoxPilot controller
# =========================
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=0
DATABASE_PATH=./data/voxpilot.sqlite3
VOICE_DATA_DIR=./data/voices
LOG_LEVEL=INFO
TELEGRAM_MAX_VOICE_MB=20

# =========================
# Vast.ai
# =========================
VAST_API_KEY=
VAST_TEMPLATE_HASH=
VAST_DOCKER_IMAGE=vastai/pytorch:@vastai-automatic-tag
VAST_DISK_GB=60
VAST_MIN_GPU_RAM_GB=24
VAST_MIN_RELIABILITY=0.98
VAST_MAX_PRICE_USD_HOUR=0.50
VAST_DEFAULT_LIMIT=8
VAST_VERIFIED_ONLY=true
VAST_DATACENTER_ONLY=false
VAST_MIN_DIRECT_PORTS=1
VAST_MIN_INET_DOWN_MBPS=500
VAST_CANCEL_UNAVAILABLE=true
VAST_AUTO_DESTROY_ON_PROVISION_FAILURE=false

VOXPILOT_REPO_URL=https://github.com/ahmed9461/VoxPilot.git
VOXPILOT_REPO_REF=main

# =========================
# Fish Audio S2 Pro
# =========================
FISH_SPEECH_REPO_URL=https://github.com/fishaudio/fish-speech.git
FISH_SPEECH_REF=214da3cd841bda85da2496b96cd3c4d7edb1337e
FISH_MODEL_REPO=fishaudio/s2-pro
FISH_UV_EXTRA=cu126
FISH_API_PORT=8080
FISH_COMPILE=false
FISH_HALF=false
FISH_USE_HTTPS=false
FISH_VERIFY_TLS=false
FISH_REQUEST_TIMEOUT_SECONDS=600
FISH_READY_TIMEOUT_SECONDS=1800
PROVISION_POLL_SECONDS=5
HF_TOKEN=

# =========================
# Cost Guard
# =========================
COST_GUARD_WARN_MINUTES=30
COST_GUARD_AUTO_DESTROY_MINUTES=0
COST_GUARD_POLL_SECONDS=60

# Advertised Mbps, not MB/s or a measured Hugging Face download guarantee.
# Priority tiers: >=5x preferred, >=2x, >=preferred, >=0.5x; price within tier.
VAST_PREFERRED_INET_DOWN_MBPS=1000
VAST_MIN_INET_UP_MBPS=50
# Used ONLY after selecting the explicit slower-alternatives button.
VAST_SLOW_INET_DOWN_MBPS=100
PENDING_RENTAL_WARN_SECONDS=120
DESTROY_CONFIRMATION_SECONDS=300
# Pin to a verified Hugging Face commit for repeatable model weights.
FISH_MODEL_REVISION=main
